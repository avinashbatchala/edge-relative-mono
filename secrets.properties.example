# Edge Relative local secrets. Copy to secrets.properties (git-ignored) and fill in.
# Spring Boot imports this file directly; Docker Compose reads it with
#   docker compose --env-file secrets.properties ...
# Exported environment variables override these values.

# --- Local PostgreSQL (Docker Compose) --------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=edge_relative
POSTGRES_USER=edge_relative
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- Groww Trading API ------------------------------------------------------
# GROWW_AUTH_MODE defaults to AUTO, which uses whichever credentials are set, so
# providing only the key and secret is enough.
GROWW_AUTH_MODE=AUTO
GROWW_API_KEY=
GROWW_API_SECRET=

# Alternative flows:
# GROWW_ACCESS_TOKEN=   # static token (expires daily at 06:00 IST)
# GROWW_TOTP_CODE=      # TOTP flow (also needs GROWW_API_KEY)

# --- LLM (advisory narration only; never trading authority) ------------------
# The Java backend is the only process that calls the provider for the app; the
# key must never be bundled into the frontend or the macOS app. Provider is
# selected by LLM_PROVIDER so a local/other vendor can be substituted.
LLM_PROVIDER=deepseek
LLM_API_KEY=
# DeepSeek-specific settings (used when LLM_PROVIDER=deepseek).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Fundamentals data source ------------------------------------------------
# Free-first default uses Yahoo Finance (.NS/.BO) plus NSE/BSE filings; no key is
# required. Keep the placeholder for a future vendor behind the same port.
FUNDAMENTALS_PROVIDER=yahoo-nse
FUNDAMENTALS_API_KEY=
